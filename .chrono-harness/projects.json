{
  "schema_version": 2,
  "status": "active",
  "owners": [
    "host",
    "instructions",
    "instructions-tests"
  ],
  "projects": [
    {
      "id": "instructions",
      "kind": "production",
      "manifest": "crates/instructions/Cargo.toml",
      "lockfile": "crates/instructions/Cargo.lock",
      "root": "crates/instructions",
      "test_project": "instructions-tests",
      "actions": {
        "verify_publication": {
          "operation": "verify.instructions-publication",
          "tool": "verus",
          "argv": [
            "--crate-type=lib",
            "--no-cheating",
            "--no-external-by-default",
            "--num-threads",
            "2",
            "--output-json",
            "--compile",
            "--emit=link=.chrono-harness/state/verify.instructions-publication.rlib,dep-info=.chrono-harness/state/verify.instructions-publication.rlib.d",
            "crates/instructions/src/publication_decision.rs",
            "-o",
            ".chrono-harness/state/verify.instructions-publication.rlib",
            "-Zchecksum-hash-algorithm=sha256"
          ],
          "output_contract": {
            "version": "0.2026.04.24.f8e1704",
            "commit": "f8e17045c4ac17a02e566b8997070f2eecc255be"
          }
        }
      },
      "language": "rust"
    },
    {
      "id": "instructions-tests",
      "kind": "test",
      "manifest": "crates/instructions-tests/Cargo.toml",
      "lockfile": "crates/instructions-tests/Cargo.lock",
      "root": "crates/instructions-tests",
      "tests_for": "instructions",
      "actions": {
        "verify_publication": {
          "operation": "verify.instructions-publication-tests",
          "tool": "verus",
          "argv": [
            "--crate-type=lib",
            "--no-cheating",
            "--no-external-by-default",
            "--num-threads",
            "2",
            "--output-json",
            "--compile",
            "--emit=link=.chrono-harness/state/verify.instructions-publication-tests.rlib,dep-info=.chrono-harness/state/verify.instructions-publication-tests.rlib.d",
            "crates/instructions-tests/tests/publication_decision.rs",
            "-o",
            ".chrono-harness/state/verify.instructions-publication-tests.rlib",
            "-Zchecksum-hash-algorithm=sha256"
          ],
          "output_contract": {
            "version": "0.2026.04.24.f8e1704",
            "commit": "f8e17045c4ac17a02e566b8997070f2eecc255be"
          }
        },
        "execute": {
          "operation": "instructions.owner-check",
          "tool": "bash",
          "argv": [
            "./check.sh"
          ]
        }
      },
      "language": "rust"
    }
  ],
  "scripts": []
}
